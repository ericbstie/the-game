{
  "name": "breakout-box",
  "version": "2.25.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "serve": "bun server.ts",
    "build": "bun build ./index.html --outdir=dist --minify",
    "compile": "bun build ./server.ts --compile --minify --outfile dist/breakout-box-server",
    "test": "bun test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && bun run typecheck",
    "ci": "biome ci . && bun run typecheck",
    "version:next": "bun run scripts/next-version.ts",
    "sprite:sheet": "bun run scripts/sprite-sheet.ts",
    "sprite:frame": "bun run scripts/world-frame.ts",
    "frame:budget": "bun run scripts/frame-budget.ts",
    "delta:size": "bun run scripts/delta-size.ts",
    "ore:seams": "bun run scripts/ore-seams.ts",
    "shot:ink": "bun run scripts/shot-ink.ts",
    "burst:ink": "bun run scripts/burst-ink.ts",
    "puff:ink": "bun run scripts/puff-ink.ts",
    "lettering:ink": "bun run scripts/lettering-ink.ts"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@happy-dom/global-registrator": "^20.11.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2"
  }
}
